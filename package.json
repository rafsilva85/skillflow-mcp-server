{
  "name": "skillflow-mcp-server",
  "version": "2.0.0",
  "description": "MCP Server for SkillFlow — Connect AI coding agents to the SkillFlow AI skills marketplace. Live API integration with real-time data. Supports stdio and Streamable HTTP transports.",
  "main": "dist/index.js",
  "bin": {
    "skillflow-mcp": "dist/index.js",
    "skillflow-mcp-http": "dist/http-server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http-server.js",
    "dev": "ts-node src/index.ts",
    "dev:http": "ts-node src/http-server.ts"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-skills",
    "ai-marketplace",
    "claude",
    "cursor",
    "windsurf",
    "copilot",
    "gemini",
    "ai-agent",
    "skills",
    "skillflow",
    "coding-agent",
    "ai-tools",
    "streamable-http",
    "smithery"
  ],
  "author": "Rafael Silva <rafa.amaralsilva@gmail.com>",
  "license": "MIT",
  "homepage": "https://skillflow.builders",
  "repository": {
    "type": "git",
    "url": "https://github.com/rafsilva85/skillflow-mcp-server"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.21"
  },
  "mcpName": "io.github.rafsilva85/skillflow"
}
